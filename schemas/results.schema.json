{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netra.local/schemas/results.schema.json",
  "title": "NETRA analysis results",
  "description": "THE FROZEN CONTRACT. The single handshake between the ingestion/correlation layer, the ML core, the FastAPI backend and the NETRA dashboard. If a field changes here, the Captain announces it. Never edit silently.",
  "type": "object",
  "required": ["meta", "entities", "edges", "alerts", "clusters", "series", "geo_breakdown", "metrics"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/Meta" },
    "entities": {
      "type": "array",
      "description": "Every investigative subject: wallet clusters AND network endpoints (IPs). The dashboard graph is built from this list plus `edges`.",
      "items": { "$ref": "#/$defs/Entity" }
    },
    "edges": {
      "type": "array",
      "description": "Graph links. kind=flow is an on-chain value transfer; kind=control is a network-layer observation (IP controlled/relayed a wallet).",
      "items": { "$ref": "#/$defs/Edge" }
    },
    "alerts": {
      "type": "array",
      "description": "Ranked investigative leads, most severe first. This is the product - a lead list, not a verdict list.",
      "items": { "$ref": "#/$defs/Alert" }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/Cluster" }
    },
    "series": { "$ref": "#/$defs/Series" },
    "geo_breakdown": {
      "type": "array",
      "description": "Share of entity activity by country, descending. Powers the geo panel.",
      "items": { "$ref": "#/$defs/GeoRow" }
    },
    "metrics": { "$ref": "#/$defs/Metrics" },

    "window": {
      "$ref": "#/$defs/WindowInfo",
      "description": "MONITORING ADDITION. Which time window this payload covers. Absent for a one-shot batch analysis, present for a windowed run -- so the dashboard always knows what 'now' means."
    },
    "fleet": {
      "$ref": "#/$defs/Fleet",
      "description": "MONITORING ADDITION. Fleet-level counts for the baseline strip: is the FEED changing, not just the wallets in it."
    },
    "events": {
      "type": "array",
      "description": "MONITORING ADDITION. What changed since the previous window, with attribution. A score is a state; an event is a finding. Optional so a single-batch payload still validates.",
      "items": { "$ref": "#/$defs/Event" }
    },
    "traces": {
      "type": "array",
      "description": "MONITORING ADDITION. Traced fund paths from a lead to the services it reached. An ESTIMATE, not a fact -- see the required `method` and `assumption` fields.",
      "items": { "$ref": "#/$defs/Trace" }
    }
  },

  "$defs": {
    "Meta": {
      "type": "object",
      "required": ["records", "entities", "generated_at", "runtime_ms"],
      "additionalProperties": false,
      "properties": {
        "records": { "type": "integer", "minimum": 0, "description": "Normalized transaction observations ingested" },
        "transactions": { "type": "integer", "minimum": 0, "description": "Distinct txids seen" },
        "entities": { "type": "integer", "minimum": 0 },
        "total_value_btc": { "type": "number", "minimum": 0, "description": "Sum of all output amounts across the ingested records -- the true total value moved. Reported so the dashboard never has to invent a headline figure." },
        "flagged_entities": { "type": "integer", "minimum": 0, "description": "Entities at or above the medium risk band" },
        "generated_at": { "type": "string", "format": "date-time" },
        "runtime_ms": { "type": "integer", "minimum": 0 },
        "dataset": { "type": "string", "description": "e.g. synthetic_v1" },
        "source_file": { "type": "string" },
        "engine_version": { "type": "string" }
      }
    },

    "Entity": {
      "type": "object",
      "required": ["id", "label", "kind", "risk", "risk_band"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[EN]-[0-9]{4,}$", "description": "E-#### for wallet clusters, N-#### for network endpoints. Four or more digits -- larger datasets produce 5-digit ids." },
        "label": { "type": "string", "description": "Short display label for the graph node" },
        "kind": {
          "type": "string",
          "enum": ["wallet", "exchange", "mixer", "seed", "ip", "unknown"],
          "description": "Drives node colour/shape in the dashboard"
        },
        "role": { "type": "string", "description": "One-sentence human explanation of what this node is" },
        "addresses": { "type": "array", "items": { "type": "string" } },
        "cluster": { "type": ["string", "null"], "description": "Cluster id this entity belongs to, or null" },
        "cluster_size": { "type": "integer", "minimum": 0 },
        "risk": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risk_band": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "anomaly_score": { "type": ["number", "null"], "description": "Raw IsolationForest decision score (lower = more anomalous)" },
        "typology": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Detected laundering typologies e.g. peel_chain, coinjoin_mixer, ransomware_fanin, cross_border_control"
        },
        "geo": { "type": "array", "items": { "type": "string" }, "description": "ISO-3166 alpha-2 country codes observed" },
        "asn": { "type": "array", "items": { "type": "string" } },
        "country_count": { "type": "integer", "minimum": 0 },
        "value_btc": { "type": "number", "minimum": 0 },
        "tx_count": { "type": "integer", "minimum": 0 },
        "first_seen": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "description": "Which model produced the risk score" },
        "community_id": { "type": ["integer", "null"], "description": "Graph community this entity belongs to, or null if it carries no material flow. NOT a verdict: weak community structure is a property of the data." },
        "community_size": { "type": ["integer", "null"], "minimum": 0, "description": "Size of that community, or 0 when the entity is in none. Never the size of the unassigned bucket -- 79 unrelated wallets are not an operation." },
        "graph_role": {
          "type": ["string", "null"],
          "enum": ["collector", "distributor", "relay", "cash-out/exchange", "mixing service", "wallet", null],
          "description": "Function within the flow graph. A heuristic label for the analyst's narrative, NOT a model input -- a rule-derived label fed to the model as a feature is how a rule quietly becomes the answer."
        },
        "history": {
          "type": "array",
          "description": "Risk across windows, oldest first. Powers the per-entity trend sparkline; an entity with no history has this empty rather than a fabricated flat line.",
          "items": {
            "type": "object",
            "required": ["window", "risk", "band"],
            "additionalProperties": false,
            "properties": {
              "window": { "type": "string" },
              "risk": { "type": "integer", "minimum": 0, "maximum": 100 },
              "band": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
            }
          }
        },
        "explanation": {
          "type": "object",
          "description": "How the score decomposes. `base + contributions == prediction` up to `residual`, which is reported rather than assumed: a non-zero residual means the explanation does not reconcile with the score on screen.",
          "required": ["method", "base", "prediction", "residual"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "description": "e.g. 'exact TreeSHAP (XGBoost pred_contribs)' or 'exact decision-path contributions (Saabas), not Shapley'. Named because they are NOT equivalent and we do not call both SHAP." },
            "base": { "type": "number" },
            "prediction": { "type": "number", "minimum": 0, "maximum": 1 },
            "residual": { "type": "number", "description": "prediction - (base + sum of contributions). Should be ~0; reported so it can be checked." }
          }
        },
        "features": {
          "type": "array",
          "description": "Feature attributions for the explainability panel bars",
          "items": {
            "type": "object",
            "required": ["name", "value", "importance"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "number" },
              "importance": { "type": "number", "description": "Signed contribution. Positive pushes toward illicit." }
            }
          }
        },
        "reasons": {
          "type": "array",
          "description": "Plain-English justifications shown on every lead. This is what makes a lead defensible.",
          "items": {
            "type": "object",
            "required": ["icon", "severity", "title", "detail"],
            "additionalProperties": false,
            "properties": {
              "icon": { "type": "string", "enum": ["flow", "exch", "time", "clus"] },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
              "title": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "timeline": {
          "type": "array",
          "description": "Ordered narrative of how the funds moved - shown in the case report",
          "items": {
            "type": "object",
            "required": ["step", "title", "detail"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "detail": { "type": "string" },
              "ref": { "type": "string", "description": "txid or address anchoring this step" },
              "critical": { "type": "boolean" }
            }
          }
        },
        "facts": {
          "type": "array",
          "description": "Key/value pairs for supporting (non-flagged) nodes",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },

    "Edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "description": "Entity id" },
        "to": { "type": "string", "description": "Entity id" },
        "kind": { "type": "string", "enum": ["flow", "control"] },
        "value": { "type": "number", "minimum": 0, "description": "BTC moved (flow edges)" },
        "label": { "type": "string", "description": "Display label e.g. '62.4 BTC'" },
        "txid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "count": { "type": "integer", "minimum": 1, "description": "Number of transfers aggregated into this edge" },
        "protocol": { "type": "string", "description": "For control edges e.g. bitcoin-p2p" }
      }
    },

    "Alert": {
      "type": "object",
      "required": ["id", "entity", "severity", "score", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^AL-[0-9]{2,}$" },
        "entity": { "type": "string", "description": "Entity id this lead points at; the graph selects this node" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "meta": { "type": "string", "description": "Short secondary line e.g. 'bc1qend ... 184.6 BTC'" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "txids": { "type": "array", "items": { "type": "string" } },

        "status": {
          "type": "string",
          "enum": ["new", "acknowledged", "investigating", "closed_false_positive", "closed_escalated"],
          "description": "MONITORING ADDITION. The analyst's decision, remembered between runs. This is what separates a tool from a report."
        },
        "first_window": { "type": ["string", "null"], "description": "Label of the window this lead first appeared in" },
        "last_window": { "type": ["string", "null"], "description": "Most recent window it was still above the floor. An alert that keeps updating is one alert, not one per run." },
        "peak_risk": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "assignee": { "type": ["string", "null"] },
        "changes": {
          "type": "array",
          "description": "MONITORING ADDITION: why this moved, ranked by change in robust z. 'Risk went up' is not actionable; 'risk 14 -> 55 because burst concentration 0.2 -> 0.5' is.",
          "items": {
            "type": "object",
            "required": ["feature", "label", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "feature": { "type": "string" },
              "label": { "type": "string" },
              "from": { "type": "number" },
              "to": { "type": "number" },
              "delta_z": { "type": "number", "description": "Change measured in robust standard deviations (median/MAD), so one whale cannot make everything else look shifted." }
            }
          }
        }
      }
    },

    "Cluster": {
      "type": "object",
      "required": ["id", "size", "method"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "method": { "type": "string", "description": "e.g. common_input+connected_components" },
        "members": { "type": "array", "items": { "type": "string" } }
      }
    },

    "Series": {
      "type": "object",
      "required": ["hourly_volume", "risk_bands"],
      "additionalProperties": false,
      "properties": {
        "hourly_volume": {
          "type": "array",
          "description": "3-hour buckets of traced BTC - the volume bar chart",
          "items": {
            "type": "object",
            "required": ["hour", "btc"],
            "additionalProperties": false,
            "properties": {
              "hour": { "type": "string", "description": "e.g. '00', '03', ... '21'" },
              "btc": { "type": "number", "minimum": 0 }
            }
          }
        },
        "risk_bands": {
          "type": "object",
          "description": "Entity counts per band - the risk doughnut chart",
          "required": ["critical", "high", "medium", "low"],
          "additionalProperties": false,
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "GeoRow": {
      "type": "object",
      "required": ["country", "code", "share"],
      "additionalProperties": false,
      "properties": {
        "country": { "type": "string", "description": "Display name" },
        "code": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO-3166 alpha-2; the dashboard derives the flag emoji from this" },
        "share": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of flagged activity, 0..1" },
        "entity_count": { "type": "integer", "minimum": 0 }
      }
    },

    "Metrics": {
      "type": "object",
      "description": "Honest evaluation scores against the planted ground truth. Nulls are allowed and mean 'not yet measured' - never fake a number here.",
      "required": ["evaluated_on"],
      "additionalProperties": false,
      "properties": {
        "evaluated_on": { "type": "string", "description": "e.g. 'planted ground truth, 20% held-out split'" },
        "risk_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "risk_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "risk_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "risk_auc": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "cluster_ari": { "type": ["number", "null"], "minimum": -1, "maximum": 1, "description": "Adjusted Rand Index of clustering vs true_entity_id" },
        "anomaly_precision_at_k": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "anomaly_k": { "type": "integer", "minimum": 1, "description": "The k in precision@k" },
        "true_positives": { "type": ["integer", "null"] },
        "false_positives": { "type": ["integer", "null"] },
        "false_negatives": { "type": ["integer", "null"] },
        "train_size": { "type": ["integer", "null"] },
        "test_size": { "type": ["integer", "null"] }
      }
    },

    "WindowInfo": {
      "type": "object",
      "description": "Which slice of time this payload covers. Every number in a monitoring payload is window-scoped, so the window has to be on screen.",
      "required": ["id", "label", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "index": { "type": "integer", "minimum": 1, "description": "Position in the sequence, 1-based" },
        "total": { "type": "integer", "minimum": 1, "description": "How many windows exist, so the UI can render '4 of 9' without a second request" }
      }
    },

    "Fleet": {
      "type": "object",
      "description": "Counts about the FEED rather than the wallets in it, so an analyst can tell whether the data changed or the world did.",
      "additionalProperties": false,
      "properties": {
        "transactions": { "type": "integer", "minimum": 0 },
        "entities": { "type": "integer", "minimum": 0 },
        "new_entities": { "type": "integer", "minimum": 0 },
        "merged_entities": { "type": "integer", "minimum": 0 },
        "rows_rejected": { "type": "integer", "minimum": 0, "description": "Rejected by the data-quality gate. Silent data loss is indefensible, so the count is surfaced rather than swallowed." },
        "events": { "type": "integer", "minimum": 0 },
        "open_alerts": { "type": "integer", "minimum": 0 }
      }
    },

    "Event": {
      "type": "object",
      "description": "Something that CHANGED. A score is a state; a state that has not changed tells an analyst nothing new. Includes event types that can only exist across time (DORMANT, RESURGENT).",
      "required": ["id", "window", "entity", "type", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "window": { "type": "string" },
        "entity": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["NEW_ENTITY", "ESCALATION", "DE_ESCALATION", "DORMANT", "RESURGENT",
                   "CLUSTER_GROWTH", "BEHAVIOUR_SHIFT", "CLUSTER_MERGE"]
        },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "title": { "type": "string", "description": "Headline the analyst reads first" },
        "detail": { "type": "string", "description": "The reason in plain language, built from the attribution" },
        "risk_from": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "risk_to": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "absorbed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "CLUSTER_MERGE only: entity keys absorbed into this one. Two operations being linked is a finding, not bookkeeping."
        },
        "changes": {
          "type": "array",
          "description": "Attribution: which features moved, ranked by change in robust z",
          "items": {
            "type": "object",
            "required": ["feature", "label", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "feature": { "type": "string" },
              "label": { "type": "string" },
              "from": { "type": "number" },
              "to": { "type": "number" },
              "delta_z": { "type": "number" }
            }
          }
        }
      }
    },

    "Trace": {
      "type": "object",
      "description": "A traced fund path from a seed to the services it reached. ALWAYS an estimate: Bitcoin is fungible, so per-hop allocation is an allocation MODEL, not a fact. `method` and `assumption` are required so a traced figure can never be quoted without the model that produced it.",
      "required": ["seed", "tainted", "method", "assumption", "sinks"],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "string" },
        "tainted": { "type": "number", "minimum": 0, "description": "Value the seed sent outward" },
        "hops_reached": { "type": "integer", "minimum": 0 },
        "method": { "type": "string" },
        "assumption": { "type": "string" },
        "sinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "kind", "amount", "hops", "path"],
            "additionalProperties": false,
            "properties": {
              "entity": { "type": "string" },
              "kind": { "type": "string", "enum": ["exchange", "mixer"] },
              "amount": { "type": "number", "minimum": 0 },
              "hops": { "type": "integer", "minimum": 1 },
              "path": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
